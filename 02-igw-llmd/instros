4)kubectl create namespace ${NAMESPACE}
namespace/llm-d-optimized-baseline created

5)kubectl apply -n ${NAMESPACE} -k "./guides/recipes/gateway/gke-l7-rilb"
gateway.gateway.networking.k8s.io/llm-d-inference-gateway created

6)kubectl get gateway -n ${NAMESPACE} llm-d-inference-gateway
wait until programmed is true (2-3 minutes)
pmotgi-mac:llm-d pmotgi$ kubectl get gateway -n ${NAMESPACE} llm-d-inference-gateway
NAME                      CLASS         ADDRESS        PROGRAMMED   AGE
llm-d-inference-gateway   gke-l7-rilb   10.202.0.177   True         61s

7) export GAIE_VERSION=v1.5.0
export GUIDE_NAME="optimized-baseline"
export NAMESPACE=llm-d-optimized-baseline

8)kubectl apply -k "https://github.com/kubernetes-sigs/gateway-api-inference-extension/config/crd?ref=${GAIE_VERSION}"
customresourcedefinition.apiextensions.k8s.io/inferencemodelrewrites.inference.networking.x-k8s.io configured
