cd to llm-d before running below commands:


1) create proxy only subnet
gcloud compute networks subnets create pmotgi-tr-po-subnet \
    --purpose=REGIONAL_MANAGED_PROXY \
    --role=ACTIVE \
    --region=us-east5 \
    --network=default \
    --range=192.168.0.0/23

takes few minutes to run

2) Update cluster for gateway api
export GAIE_VERSION=v1.5.0
export GUIDE_NAME="optimized-baseline"
export NAMESPACE=llm-d-optimized-baseline
export INFRA_PROVIDER=gke

3)kubectl apply -k "https://github.com/kubernetes-sigs/gateway-api-inference-extension/config/crd?ref=${GAIE_VERSION}"

